{
  "name": "",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed:notices": "tsx --env-file=.env scripts/seed-notice.ts",
    "chunk:preview": "tsx scripts/chunk-preview.ts",
    "reindex": "tsx --env-file=.env scripts/reindex.ts",
    "rag:test": "tsx --env-file=.env scripts/rag-test.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.1.1",
    "@langchain/core": "^1.2.1",
    "@langchain/textsplitters": "^1.0.1",
    "@payloadcms/db-mongodb": "3.40.0",
    "@payloadcms/next": "3.40.0",
    "@payloadcms/payload-cloud": "3.40.0",
    "@payloadcms/richtext-lexical": "3.40.0",
    "@payloadcms/storage-s3": "3.40.0",
    "@payloadcms/translations": "^3.40.0",
    "@payloadcms/ui": "3.40.0",
    "@tailwindcss/postcss": "^4.1.8",
    "aos": "^2.3.4",
    "cloudinary": "^2.10.0",
    "cross-env": "^7.0.3",
    "fuse.js": "^7.1.0",
    "graphql": "^16.8.1",
    "gsap": "^3.15.0",
    "langchain": "^1.5.2",
    "next": "15.3.8",
    "nodemailer": "^8.0.1",
    "payload": "3.40.0",
    "react": "19.1.0",
    "react-countup": "^6.5.3",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.59.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-paginate": "^8.3.0",
    "react-visibility-sensor": "^5.1.1",
    "sharp": "0.32.6",
    "slugify": "^1.6.6",
    "swiper": "^11.2.8",
    "tailwind-merge": "^3.4.0",
    "yet-another-react-lightbox": "^3.24.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.3.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.5",
    "prettier": "^3.4.2",
    "stylelint": "^16.20.0",
    "tailwindcss": "^4.1.10",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
